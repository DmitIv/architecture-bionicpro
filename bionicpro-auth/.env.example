# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=reports-realm
KEYCLOAK_CLIENT_ID=reports-frontend
KEYCLOAK_CLIENT_SECRET=

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Configuration
SESSION_SECRET_KEY=change-me-in-production-use-32-byte-key
SESSION_MAX_AGE=1800
SESSION_COOKIE_NAME=bionicpro_session

# Token Configuration
ACCESS_TOKEN_TTL=120
REFRESH_TOKEN_TTL=2592000
ENCRYPTION_KEY=change-me-in-production-use-fernet-key-32-bytes

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Yandex OAuth Configuration
YANDEX_CLIENT_ID=your_yandex_client_id_here
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here
YANDEX_OAUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_USERINFO_URL=https://login.yandex.ru/info

# Database Configuration for User Profiles
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bionicpro_users
POSTGRES_USER=bionicpro
POSTGRES_PASSWORD=secure_password
